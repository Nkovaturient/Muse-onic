# Python & Models
MUSEONIC_PYTHON_BIN=
MUSEONIC_WHISPER_MODEL=base
MUSEONIC_WHISPER_LANG=
MUSEONIC_MELODY_SCRIPT=
MUSEONIC_MELODY_SAMPLE_RATE=22050
MUSEONIC_MELODY_DURATION=8

# Recording / Audio
MUSEONIC_RECORD_DIR=
MUSEONIC_SAMPLE_RATE=16000
MUSEONIC_CHANNELS=1
MUSEONIC_RECORD_THRESHOLD=0

# Playback
MUSEONIC_MPV_PATH=mpv
MUSEONIC_VLC_PATH=vlc
MUSEONIC_YTDLP_PATH=yt-dlp
# mic = default for humming/singing; system = BlackHole loopback; auto = use loopback on macOS only if installed
MUSEONIC_RECORDING_MODE=mic
MUSEONIC_GH_TOKEN= #github token

# Ollama
MUSEONIC_OLLAMA_BASE_URL=http://localhost:11434
MUSEONIC_OLLAMA_MODEL=llama3.2

# n8n Automation
MUSEONIC_N8N_ENABLED=false
MUSEONIC_N8N_BASE_URL=http://localhost:5678
MUSEONIC_N8N_TOKEN=

# ACRCloud (optional)
ACR_LINK=
MUSEONIC_ACR_HOST=
MUSEONIC_ACR_ACCESS_KEY=
MUSEONIC_ACR_ACCESS_SECRET=

# Search
MUSEONIC_SEARCH_USE_LIBRARY=true  # Use library (default) or false for direct HTTP only
MUSEONIC_SEARCH_PROVIDER=serpapi
MUSEONIC_SEARCH_TIMEOUT=45000 
SERPAPI_KEY=

# Logging
MUSEONIC_LOG_LEVEL=info